# ════════════════════════════════════════════════════════════════════════
#  jarvis run — авто-починка + запуск
# ════════════════════════════════════════════════════════════════════════
wait_health() {
    local url="$1" label="$2" tries="${3:-90}" i
    printf '  ожидаю %s' "$label"
    for ((i=0; i<tries; i++)); do
        if http_get "$url" 2 | grep -q '"ok"'; then echo "  ✓"; return 0; fi
        printf '.'; sleep 1
    done
    echo "  ✗"; return 1
}

cmd_run() {
    printf '%s%s═══ JARVIS · запуск ═══%s\n' "$C_CYAN" "$C_BOLD" "$C_RESET"

    # 1. Лёгкая авто-починка отсутствующего (без принудительной пересборки).
    local py; py="$(venv_python)"
    [ -z "$py" ] && { ensure_venv; py="$(venv_python)"; }
    if [ -z "$py" ]; then crit "нет venv и не удалось создать — запусти jarvis setup"; exit 1; fi

    local embed_gguf; embed_gguf="$(ls "$EMBED_DIR"/*.gguf 2>/dev/null | head -1)"
    if [ ! -x "$SERVER_BIN" ] || [ ! -f "$CHAT_MODEL" ] || [ -z "$embed_gguf" ]; then
        warn "сервер/модели отсутствуют — добираю (с выбором источника)"
        ensure_models_reachability
        ensure_servers_built
    fi

    # 2. Поднять оба сервера.
    if have_systemd; then
        step "Поднимаю серверы (systemd --user)"
        [ -f "$UNIT_DIR/jarvis-llm.service" ] && systemctl --user start jarvis-llm.service 2>/dev/null
        [ -f "$UNIT_DIR/jarvis-embed.service" ] && systemctl --user start jarvis-embed.service 2>/dev/null
    else
        note "systemd --user недоступен — серверы должны быть запущены отдельно"
    fi
    wait_health "$CHAT_ENDPOINT/health"  "мозг (:8080)"   120 || warn "мозг не ответил — логи: jarvis logs llm"
    wait_health "$EMBED_ENDPOINT/health" "память (:8090)" 60  || warn "память не ответила — логи: jarvis logs embed"

    # 3. Запустить ассистента в foreground (Ctrl+C — стоп).
    step "Запускаю ассистента (Ctrl+C — остановить)"
    exec "$py" -m src.core.supervisor foreground
}

# ════════════════════════════════════════════════════════════════════════
#  управление
# ════════════════════════════════════════════════════════════════════════
cmd_status() {
    hdr "Состояние"
    local map=( "jarvis-llm:мозг (:8080)" "jarvis-embed:память (:8090)" "jarvis:ассистент" )
    for pair in "${map[@]}"; do
        IFS=':' read -r unit label <<<"$pair"
        if have_systemd && [ -f "$UNIT_DIR/$unit.service" ]; then
            local st; st="$(systemctl --user is-active "$unit" 2>/dev/null)"
            [ "$st" = "active" ] && ok "$label — active" || warn "$label — $st"
        else
            note "$label — юнит не установлен / нет systemd"
        fi
    done
    http_get "$CHAT_ENDPOINT/health" 3  | grep -q '"ok"' && ok "мозг отвечает на $CHAT_ENDPOINT"  || warn "мозг молчит"
    http_get "$EMBED_ENDPOINT/health" 3 | grep -q '"ok"' && ok "память отвечает на $EMBED_ENDPOINT" || warn "память молчит"
}

cmd_stop() {
    step "Остановка"
    if have_systemd; then
        systemctl --user stop jarvis 2>/dev/null && ok "ассистент остановлен" || true
        systemctl --user stop jarvis-embed 2>/dev/null && ok "память остановлена" || true
        systemctl --user stop jarvis-llm 2>/dev/null && ok "мозг остановлен" || true
    fi
    local py; py="$(venv_python)"
    [ -n "$py" ] && "$py" -m src.core.supervisor stop 2>/dev/null || true
}

cmd_restart() {
    if have_systemd && systemctl --user is-active --quiet jarvis 2>/dev/null; then
        systemctl --user restart jarvis && ok "ассистент перезапущен"
    else
        local py; py="$(venv_python)"
        [ -n "$py" ] && exec "$py" -m src.core.supervisor restart
    fi
}

cmd_logs() {
    local which="${1:-jarvis}" unit
    case "$which" in
        llm|brain|мозг)    unit="jarvis-llm";;
        embed|mem|память)  unit="jarvis-embed";;
        *)                 unit="jarvis";;
    esac
    if have_systemd; then
        printf '%s📋 Логи %s (Ctrl+C — выход)%s\n' "$C_YELLOW" "$unit" "$C_RESET"
        journalctl --user -u "$unit" -f
    else
        warn "systemd --user недоступен; в foreground-режиме логи идут прямо в консоль"
    fi
}

cmd_wipe_memory() {
