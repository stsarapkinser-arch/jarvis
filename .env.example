# JARVIS — локальные тумблеры. Скопируй в .env и правь, либо удобнее командой:
#
#     jarvis toggle                   # список и текущее состояние
#     jarvis toggle stream-tts on     # включить
#     jarvis toggle kv-quant q8_0     # значение
#
# .env читается командой jarvis ДО старта (и сервера, и рантайма). Значение,
# заданное в шелле (JARVIS_X=1 jarvis run), ПЕРЕБИВАЕТ .env на один запуск.
# Файл .env не коммитится (.gitignore) — у каждой машины свой профиль.
#
# Два класса тумблеров по тому, КТО их читает:
#   build   — запекаются в jarvis-llm.service ⇒ применить:  jarvis setup
#   runtime — читает python при старте          ⇒ применить:  jarvis restart

# ── Сборка сервера (класс build) ─────────────────────────────────────────
# KV-quant + flash-attn: вдвое режет KV-кэш, ускоряет декод. Vulkan-FA бывает
# версионно-капризна — если сервер не стартует, убери (jarvis toggle kv-quant off).
# JARVIS_LLM_KV_QUANT=q8_0

# Speculative decoding: draft-модель 0.5B предсказывает токены за 3B. На 8 ГБ
# RAM впритык — мерить tok/s. draft-GGUF докачается при jarvis setup.
# JARVIS_LLM_DRAFT=1

# ── Рантайм (класс runtime) ──────────────────────────────────────────────
# Streaming TTS: ответ озвучивается по предложениям — первое слово раньше.
# JARVIS_STREAM_TTS=1

# Wake-word пред-гейт перед Vosk (меньше нагрев/ложные срабатывания).
# Нужен: pip install openwakeword. Без пакета — fail-open (не блокирует).
# JARVIS_WAKEWORD=1
# JARVIS_WAKEWORD_WINDOW=1.2
# JARVIS_WAKEWORD_THRESHOLD=0.5

# L2: семантический матч навыка по эмбеддингам (парафраз без 3B). Сначала
# откалибруй порог:  python scripts/calibrate_semantic.py
# JARVIS_SEMANTIC_MATCH=1
# JARVIS_SEMANTIC_THRESHOLD=0.78
