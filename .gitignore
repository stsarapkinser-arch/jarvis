# Локальные тумблеры (jarvis toggle пишет сюда) — у каждой машины свои.
# Шаблон со всеми опциями — в .env.example (он коммитится).
.env

# Личные голосовые команды оператора (jarvis commands пишет сюда).
# Шаблон с примерами — в config/commands.example.toml (он коммитится).
config/commands.toml

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Large model/binary assets — НЕ в git, докачиваются скриптами:
#   models/        — GGUF-веса мозга/эмбеддера (setup_server.sh / setup_embed_server.sh)
#   piper/         — TTS-бинарь + либы + espeak-ng-data + голос (scripts/fetch_assets.sh)
#   model/         — Vosk акустическая модель слуха (scripts/fetch_assets.sh)
# model/README (статистика WER) оставляем в git как документацию.
models/
/piper/
/model/*
!/model/README

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
jarvis_memory/

# Локальные хуки/настройки агента — не часть репозитория
.claude/

# Временные inline KWin-скрипты (создаются в рантайме); сам каталог сохраняем
scripts/_inline/*
!scripts/_inline/.gitkeep
