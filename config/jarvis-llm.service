[Unit]
Description=JARVIS LLM — native llama-server (Qwen2.5-3B-Instruct, Vulkan/iGPU)
# Только loopback REST на 127.0.0.1:8080 — графическая сессия не нужна.
After=network.target

[Service]
# llama-server работает в foreground → Type=exec, systemd держит сам процесс.
Type=exec
WorkingDirectory=__JARVIS_HOME__

# ─────────────────────── Запуск (критично для N100, 8 ГБ shared RAM) ──────────
#   --ctx-size 4096      ВАЖНО: на этом железе --ctx-size 8192 давал
#                        vk::DeviceLostError и раздувал KV-кэш в shared VRAM
#                        (iGPU делит RAM с системой). 4096 стабилен; микро-промпт
#                        + 4-секционный контекст укладываются с запасом, ~3000
#                        токенов остаётся на ответ. Подними, если памяти больше.
#   --n-gpu-layers 99    полная выгрузка ВСЕХ слоёв в Intel iGPU (Vulkan).
#   --cache-ram 0        КЛЮЧЕВОЕ для 8 ГБ: отключаем server prompt-cache pool.
#                        По умолчанию он до 8192 MiB — на 8-гиговой машине это
#                        своп и дисковый трэш (в логах оператора было
#                        «prompt cache update took 17888 ms» → запрос >120с →
#                        таймаут). Префикс системного промпта всё равно
#                        переиспользуется слотом (--parallel 1) — выигрыш TTFT
#                        сохраняется БЕЗ дорогого save/restore KV-состояний.
#   --cache-reuse 256    переиспользование KV-чанков при расхождении промпта.
#   --parallel 1         один слот → стабильный префикс кэшируется максимально.
#   --jinja              ОБЯЗАТЕЛЬНО для tool-calling Qwen2.5 (парсинг tool_calls
#                        в OpenAI-формат через встроенный chat-template).
#   --threads 4          N100 = 4 P-core.
#   KV-quant + flash-attn (строка-плейсхолдер ниже): включается setup_server.sh
#                        при JARVIS_LLM_KV_QUANT=q8_0 (или q4_0) → flash-attn on +
#                        cache-type-k/-v. Вдвое режет KV-кэш в shared VRAM
#                        (освобождает RAM под контекст/спекуляцию) и ускоряет
#                        декод. На своей строке — чтобы strip-safety снял её
#                        целиком, если сборка/Mesa не тянет Vulkan-FA. По умолч. OFF.
#   Speculative decoding (строка-плейсхолдер ниже): включается setup_server.sh
#                        при JARVIS_LLM_DRAFT=1 → --model-draft + --draft-max.
#                        Draft-модель предсказывает токены за основную; на 8 ГБ
#                        впритык — мерить tok/s. На своей строке для strip-safety.
#   Перф-флаги оператора (последняя строка-плейсхолдер): JARVIS_LLM_EXTRA_FLAGS.
# setup_server.sh снимает флаги, не поддержанные конкретной сборкой бинаря, и
# подставляет/удаляет строки-плейсхолдера по env-тумблерам.
ExecStart=__LLAMA_SERVER_BIN__ \
    --model __JARVIS_HOME__/models/__MODEL_NAME__ \
    --alias __MODEL_ALIAS__ \
    --ctx-size 4096 \
    --n-gpu-layers 99 \
    __KV_QUANT_FLAGS__ \
    __DRAFT_FLAGS__ \
    --parallel 1 \
    --threads 4 \
    --cache-ram 0 \
    --cache-reuse 256 \
    --jinja \
    __EXTRA_FLAGS__ \
    --host 127.0.0.1 \
    --port 8080

# Бессмертие сервера: нативный краш бэкенда (Vulkan/GGML_ASSERT) убивает ТОЛЬКО
# этот демон — Jarvis выживает и переподнимет соединение. systemd рестартит за 2с.
Restart=always
RestartSec=2
# Дать инференсу приоритет планировщика (отзывчивость голоса важнее фона).
Nice=-5
# Vulkan/Mesa на Intel: пусть драйвер сам выберет ANV. Переопределяемо в drop-in.
Environment=GGML_VK_VISIBLE_DEVICES=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
