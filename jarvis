#!/usr/bin/env bash
# jarvis — единая точка входа. Одной командой проверить, починить и запустить.
#
#   jarvis run        поднять серверы и запустить ассистента (с авто-починкой)
#   jarvis test       полная диагностика: компоненты, серверы, память (read-only)
#   jarvis setup      установить/докачать всё, чего не хватает
#   jarvis help       список всех команд (на русском)
#
# Скрипт — диспетчер: тяжёлую работу делегирует идемпотентным
# setup_server.sh / setup_embed_server.sh / scripts/install_service.sh,
# а сам отвечает за единый UX, локализацию и сквозную проверку.
#
# Намеренно НЕ используем `set -e`: диагностика должна пройти до конца и
# собрать все проблемы, а не падать на первой. Критичные сбои в run/setup
# обрабатываются явными проверками и кодами возврата.
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_ROOT"

# ───────────────────────── палитра и примитивы ─────────────────────────
if [ -t 1 ]; then
    C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
    C_RED=$'\033[0;31m'; C_GREEN=$'\033[0;32m'; C_YELLOW=$'\033[1;33m'
    C_CYAN=$'\033[1;36m'; C_BLUE=$'\033[0;34m'
else
    C_RESET=''; C_DIM=''; C_BOLD=''; C_RED=''; C_GREEN=''; C_YELLOW=''; C_CYAN=''; C_BLUE=''
fi

# Счётчики для итогового вердикта диагностики.
N_OK=0; N_WARN=0; N_CRIT=0

hdr()  { printf '\n%s%s%s\n' "$C_CYAN$C_BOLD" "$*" "$C_RESET"; }
ok()   { N_OK=$((N_OK+1));   printf '  %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { N_WARN=$((N_WARN+1)); printf '  %s⚠%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
crit() { N_CRIT=$((N_CRIT+1)); printf '  %s✗%s %s\n' "$C_RED" "$C_RESET" "$*"; }
note() { printf '    %s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }
step() { printf '\n%s→ %s%s\n' "$C_BLUE$C_BOLD" "$*" "$C_RESET"; }

have() { command -v "$1" >/dev/null 2>&1; }

# ───────────────────────── константы окружения ─────────────────────────
SERVER_BIN="$REPO_ROOT/llama.cpp/build/bin/llama-server"
CHAT_MODEL="$REPO_ROOT/models/Llama-3.2-3B-Instruct-Q4_K_M.gguf"
EMBED_DIR="$REPO_ROOT/models/embed"
VOSK_MODEL="$REPO_ROOT/model"
PIPER_BIN="$REPO_ROOT/piper/piper"
PIPER_VOICE="$REPO_ROOT/piper/ru_RU-dmitry-medium.onnx"
PIPER_CFG="$REPO_ROOT/piper/ru_RU-dmitry-medium.json"
MEMORY_DIR="$REPO_ROOT/jarvis_memory"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

CHAT_ENDPOINT="${JARVIS_LLM_ENDPOINT:-http://127.0.0.1:8080}"
EMBED_ENDPOINT="${JARVIS_EMBED_ENDPOINT:-http://127.0.0.1:8090}"
EMBED_MODEL_ALIAS="${JARVIS_EMBED_MODEL:-multilingual-e5-small}"

# venv: тот же поиск, что в start_jarvis.sh (без realpath — иначе venv не активен).
venv_python() {
    if [ -f "$REPO_ROOT/.venv/bin/python" ]; then echo "$REPO_ROOT/.venv/bin/python"
    elif [ -f "$REPO_ROOT/venv/bin/python" ]; then echo "$REPO_ROOT/venv/bin/python"
    else echo ""; fi
}

# systemctl --user доступен? (на dev-машине/без user-сессии — нет; деградируем).
have_systemd() { have systemctl && systemctl --user show-environment >/dev/null 2>&1; }

# curl/wget с молчаливым GET.
http_get() {
    if have curl; then curl -fsS --max-time "${2:-4}" "$1" 2>/dev/null
    elif have wget; then wget -q -T "${2:-4}" -O - "$1" 2>/dev/null
    else return 2; fi
}

# Достижим ли URL (только заголовки, без тела) — для проверки источника моделей.
reachable() {
    if have curl; then curl -fsS --max-time "${2:-6}" -o /dev/null -I "$1" 2>/dev/null
    elif have wget; then wget -q -T "${2:-6}" --spider "$1" 2>/dev/null
    else return 2; fi
}
net_dns_ok() { getent hosts "$1" >/dev/null 2>&1; }
net_ip_ok()  { ping -c1 -W2 1.1.1.1 >/dev/null 2>&1; }

# Источники моделей: основной HF и зеркало (на случай блокировки/региона).
CHAT_MODEL_URL_HF="https://huggingface.co/bartowski/Llama-3.2-3B-Instruct-GGUF/resolve/main/Llama-3.2-3B-Instruct-Q4_K_M.gguf?download=true"
# Публичное зеркало e5-small с корректной геометрией (ChristianAzinn ушёл в 401,
# tuskbot битый: context_length 511 vs тензор 512). keisuke-miyako грузится.
EMBED_MODEL_URL_HF="https://huggingface.co/keisuke-miyako/multilingual-e5-small-gguf-f16/resolve/main/multilingual-e5-small-F16.gguf?download=true"
OFFLINE=0  # выставляется ensure_models_reachability при отсутствии источника

# ───────────────── карта внешних инструментов → apt-пакет ─────────────────
# Формат: "бинарь:apt-пакет:класс". класс = build|core|opt.
#   build — нужно для сборки llama-server (только setup)
#   core  — без него заметно деградирует ядро
#   opt   — навык изящно отключается, не критично
TOOLS=(
    "git:git:build"
    "cmake:cmake:build"
    "cc:build-essential:build"
    "glslc:glslc:build"
    "vulkaninfo:vulkan-tools:build"
    "python3:python3:core"
    "sox:sox:core"
    "aplay:alsa-utils:core"
    "tesseract:tesseract-ocr:opt"
    "grim:grim:opt"
    "wmctrl:wmctrl:opt"
    "notify-send:libnotify-bin:opt"
    "playerctl:playerctl:opt"
    "wpctl:wireplumber:opt"
    "brightnessctl:brightnessctl:opt"
    "nmap:nmap:opt"
    "firejail:firejail:opt"
    "bwrap:bubblewrap:opt"
    "aria2c:aria2:opt"
    "curl:curl:core"
)

# Python-зависимости (импорт → пакет для сообщения).
PYDEPS=(
    "httpx" "chromadb" "vosk" "sounddevice" "PyQt6" "qasync"
    "psutil" "dbus_next" "numpy"
)

# ════════════════════════════════════════════════════════════════════════
#  jarvis help
