[Unit]
Description=JARVIS Protocol — AI Orchestrator for Kali Linux
After=graphical-session.target sound.target plasma-kwin_wayland.service
PartOf=graphical-session.target
# Ollama (LLM brain) и KDE Connect (Pixel bridge) — soft-dep,
# не падаем если их нет, но дожидаемся графической сессии.
Wants=ollama.service

[Service]
# Бессмертие: ExecStart запускает внешний супервизор (слой 2), который
# стережёт python -m src.core.bootstrap и поднимает его при любом падении/
# убийстве. foreground — супервизор не демонизируется, его держит сам systemd.
Type=notify
# sd_notify (READY=1/WATCHDOG=1) шлёт дочерний bootstrap, не супервизор,
# поэтому нужен all, а не main.
NotifyAccess=all
WorkingDirectory=__JARVIS_HOME__
ExecStart=__JARVIS_PYTHON__ -m src.core.supervisor foreground
ExecStop=__JARVIS_PYTHON__ -m src.core.supervisor stop
Restart=always
RestartSec=2
# Системд watchdog: если event-loop bootstrap завис (дедлок, OOM) и перестал
# слать WATCHDOG=1 — systemd убивает cgroup юнита и перезапускает через 2с.
WatchdogSec=30
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=__JARVIS_HOME__
# llama-cpp: iGPU по умолчанию. Если GPU-probe (subprocess-тест загрузки модели)
# упадёт с SIGABRT/SIGSEGV, сервер автоматически откатится на CPU.
# Чтобы принудительно отключить probe: JARVIS_LLAMA_GPU_PROBE=0
# Чтобы использовать CPU-only: JARVIS_LLAMA_GPU_LAYERS=0
Environment=JARVIS_LLAMA_GPU_LAYERS=-1
# n_ctx=4096 — вдвое меньше n_ctx=8192; KV-кэш занимает ~0.5 ГБ вместо ~1 ГБ.
# N100 iGPU делит RAM с системой; 8192 был причиной vk::DeviceLostError.
Environment=JARVIS_LLAMA_CTX=4096
Environment=QT_QPA_PLATFORM=wayland
# OpenGL на Intel N100: дать Mesa выбрать iris (Gen12) — без override
# падал на llvmpipe. Если у пользователя другой драйвер — пусть
# переопределит в drop-in.
Environment=MESA_LOADER_DRIVER_OVERRIDE=iris

[Install]
WantedBy=graphical-session.target
