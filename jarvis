# ════════════════════════════════════════════════════════════════════════
#  jarvis test — read-only диагностика
# ════════════════════════════════════════════════════════════════════════
check_python() {
    hdr "[1] Python-окружение"
    local py; py="$(venv_python)"
    if [ -z "$py" ]; then
        crit "venv не найден (.venv/ или venv/) — \`jarvis setup\` создаст"
        return
    fi
    ok "venv: $py"
    local missing=()
    for mod in "${PYDEPS[@]}"; do
        "$py" -c "import $mod" >/dev/null 2>&1 || missing+=("$mod")
    done
    if [ "${#missing[@]}" -eq 0 ]; then
        ok "зависимости установлены (${#PYDEPS[@]} модулей)"
    else
        crit "не импортируются: ${missing[*]}"
        note "почини: jarvis setup  (pip install -r config/requirements.txt)"
    fi
}

check_artifacts() {
    hdr "[2] Бинарь сервера и модели"
    if [ -x "$SERVER_BIN" ]; then ok "llama-server собран"
    else crit "llama-server не собран — \`jarvis setup\` (или ./setup_server.sh)"; fi

    if [ -f "$CHAT_MODEL" ]; then ok "модель мозга: $(du -h "$CHAT_MODEL" 2>/dev/null | cut -f1)  Llama-3.2-3B"
    else crit "нет GGUF мозга: $CHAT_MODEL"; fi

    local embed_gguf; embed_gguf="$(ls "$EMBED_DIR"/*.gguf 2>/dev/null | head -1)"
    if [ -n "$embed_gguf" ]; then ok "embedding-модель: $(basename "$embed_gguf")"
    else crit "нет embedding-модели в $EMBED_DIR"; fi

    if [ -d "$VOSK_MODEL" ] && [ -n "$(ls -A "$VOSK_MODEL" 2>/dev/null)" ]; then ok "Vosk-модель (слух) на месте"
    else warn "Vosk-модель не найдена в $VOSK_MODEL — распознавание речи не поедет"; fi
}

check_network() {
    hdr "[*] Сеть и источник моделей"
    local embed_gguf; embed_gguf="$(ls "$EMBED_DIR"/*.gguf 2>/dev/null | head -1)"
    if [ -f "$CHAT_MODEL" ] && [ -n "$embed_gguf" ]; then
        ok "обе модели на диске — сеть для установки не нужна"
        return
    fi
    if net_dns_ok huggingface.co && reachable https://huggingface.co; then
        ok "huggingface.co доступен — setup скачает напрямую"
    elif net_dns_ok hf-mirror.com && reachable https://hf-mirror.com; then
        warn "HF недоступен, но зеркало hf-mirror.com — да (setup переключится сам)"
    elif net_ip_ok; then
        crit "сеть есть, DNS не резолвит (битый /etc/resolv.conf) — модели не скачать"
        note "фикс: printf 'nameserver 1.1.1.1\\n' | sudo tee /etc/resolv.conf"
    else
        crit "нет сети/DNS — подложи модели вручную (jarvis setup подскажет пути)"
    fi
}

check_proactive() {
    hdr "[*] Проактивность и взгляд на экран"
    local iv; iv="${JARVIS_PROACTIVE_INTERVAL:-1200}"
    if [ "$iv" = "1200" ] || [ -z "${JARVIS_PROACTIVE_INTERVAL:-}" ]; then
        ok "порог тишины: 1200с (20 мин) — штатный режим"
        note "для быстрой проверки взгляда: JARVIS_PROACTIVE_INTERVAL=60 jarvis run"
    else
        warn "порог тишины снижен до ${iv}с (JARVIS_PROACTIVE_INTERVAL) — тестовый режим"
        note "этот же порог гейтит и «взгляд на экран» — удобно для проверки"
    fi
    local sw; sw="${JARVIS_SCREEN_WATCH:-1}"
    case "$sw" in
        0|false|no|off) note "взгляд на экран ВЫКЛЮЧЕН (JARVIS_SCREEN_WATCH=$sw)";;
        *) ok "взгляд на экран включён (JARVIS_SCREEN_WATCH=$sw)";;
    esac
}

check_voice() {
    hdr "[3] Голос (Piper TTS)"
    [ -x "$PIPER_BIN" ] && ok "piper-бинарь" || warn "нет piper-бинаря: $PIPER_BIN"
    [ -f "$PIPER_VOICE" ] && ok "русский голос ru_RU-dmitry" || warn "нет голоса: $PIPER_VOICE"
    [ -f "$PIPER_CFG" ] && ok "конфиг голоса" || warn "нет конфига голоса: $PIPER_CFG"
}

check_kwin_scripts() {
    hdr "[*] KWin-скрипты (управление окнами HUD)"
    local sd="$REPO_ROOT/scripts" missing=0 js
    for js in highlight_window.js prepare_workspace.js enumerate_windows.js; do
        [ -f "$sd/$js" ] || { warn "нет $js"; missing=1; }
    done
    [ "$missing" -eq 0 ] && ok "named-скрипты на месте (scripts/)"
    if mkdir -p "$sd/_inline" 2>/dev/null && [ -w "$sd/_inline" ]; then
        ok "scripts/_inline/ доступен для записи (inline KWin)"
    else
        warn "scripts/_inline/ не создать/не записать — пин HUD будет спамить ошибками"
    fi
}

check_chat_server() {
    hdr "[4] Сервер-мозг (:8080)"
    local h; h="$(http_get "$CHAT_ENDPOINT/health" 4)"
    if [ -z "$h" ]; then
        crit "недоступен на $CHAT_ENDPOINT — \`jarvis run\` поднимет"
        return
    fi
    if grep -q '"ok"' <<<"$h"; then ok "/health отвечает"
    else warn "ответил, но не 'ok': $h"; fi
    # tool-calling доступен?
    local models; models="$(http_get "$CHAT_ENDPOINT/v1/models" 4)"
    grep -q '"id"' <<<"$models" && ok "модель отдаётся через /v1/models" \
        || warn "/v1/models не вернул модель"
    # GPU-оффлоад (по логам systemd, если доступны).
    if have_systemd; then
        local glog; glog="$(journalctl --user -u jarvis-llm --no-pager -n 400 2>/dev/null)"
        if grep -qiE "offloaded [0-9]+/[0-9]+ layers|Vulkan0|using Vulkan|ggml_vulkan" <<<"$glog"; then
            ok "iGPU-оффлоад активен (Vulkan)"
        else
            warn "не вижу следов Vulkan в логах — возможно инференс на CPU (медленно)"
        fi
    fi
}

check_embed_server() {
    hdr "[5] Сервер-память / эмбеддинги (:8090)"
    local h; h="$(http_get "$EMBED_ENDPOINT/health" 4)"
    if [ -z "$h" ]; then
        crit "недоступен на $EMBED_ENDPOINT — память не вспомнит; \`jarvis run\` поднимет"
        return
    fi
    ok "/health отвечает"
    # Реальная проба: непустой вектор на русскую фразу + размерность.
    local resp=""
    if have curl; then
        resp="$(curl -fsS --max-time 8 "$EMBED_ENDPOINT/v1/embeddings" \
            -H 'Content-Type: application/json' \
            -d "{\"model\":\"$EMBED_MODEL_ALIAS\",\"input\":\"проверка связи\"}" 2>/dev/null)"
    fi
    if grep -q '"embedding"' <<<"$resp"; then
        local dim; dim="$(grep -o '"embedding":\[[^]]*' <<<"$resp" | tr ',' '\n' | grep -c '.')"
        ok "эмбеддинг получен (размерность ~${dim})"
        echo "$dim" > /tmp/jarvis-live-embed-dim 2>/dev/null || true
    else
        warn "сервер жив, но /v1/embeddings не вернул вектор — проверь модель/флаг --embedding"
    fi
}

check_memory() {
    hdr "[6] Память (ChronoMemory / Chroma)"
    local db="$MEMORY_DIR/chroma.sqlite3"
    if [ ! -d "$MEMORY_DIR" ]; then
        warn "база ещё не создана — появится при первом запуске (это норма)"
        return
    fi
    if [ -f "$db" ]; then
        ok "база на месте: $db"
        if have sqlite3; then
            local rows; rows="$(sqlite3 "$db" "select count(*) from embeddings;" 2>/dev/null)"
            [ -n "$rows" ] && note "записей в памяти: $rows"
        fi
        note "ВАЖНО: при смене embedding-модели меняется размерность → база"
        note "становится несовместимой. Лечится: jarvis wipe-memory"
    else
        warn "каталог есть, но chroma.sqlite3 нет — будет создан при старте"
    fi
    [ -f "$MEMORY_DIR/skill_overrides.json" ] && ok "skill_overrides.json (самолечение навыков)" \
        || note "skill_overrides.json пока нет (появится после первой самопочинки навыка)"
}

check_tools() {
    hdr "[7] Внешние инструменты"
    # qdbus6/qdbus отдельно — ключ к самолечению навыков.
    if have qdbus6; then ok "qdbus6 (KDE/Plasma)"
    elif have qdbus; then warn "qdbus6 нет, есть qdbus — навыки самовылечатся на лету (ожидаемо)"
    else warn "ни qdbus6, ни qdbus — управление окнами/Plasma деградирует"; fi

    local b pkg cls
    for entry in "${TOOLS[@]}"; do
        IFS=':' read -r b pkg cls <<<"$entry"
        if have "$b"; then
            ok "$b"
        else
            case "$cls" in
                build) warn "$b — нужен для сборки сервера (пакет: $pkg)";;
                core)  warn "$b — ядро деградирует (пакет: $pkg)";;
                *)     note "нет $b — соответствующий навык отключится (пакет: $pkg)";;
            esac
        fi
    done
}

check_units() {
    hdr "[8] systemd --user юниты"
    if ! have_systemd; then
        note "systemd --user недоступен в этой сессии — пропускаю (норма для dev-машины)"
        return
    fi
    local u
    for u in jarvis-llm jarvis-embed jarvis; do
        if [ -f "$UNIT_DIR/$u.service" ]; then
            local st; st="$(systemctl --user is-active "$u" 2>/dev/null)"
            if [ "$st" = "active" ]; then ok "$u.service — активен"
            else warn "$u.service установлен, но $st"; fi
        else
            warn "$u.service не установлен — \`jarvis setup\` поставит"
        fi
    done
}

cmd_test() {
    printf '%s%s═══ JARVIS · диагностика ═══%s\n' "$C_CYAN" "$C_BOLD" "$C_RESET"
    check_python
    check_artifacts
    check_network
    check_voice
    check_chat_server
    check_embed_server
    check_memory
    check_proactive
    check_kwin_scripts
    check_tools
    check_units

    hdr "ИТОГ"
    printf '  %s✓ ок: %d%s   %s⚠ предупреждений: %d%s   %s✗ критично: %d%s\n' \
        "$C_GREEN" "$N_OK" "$C_RESET" \
        "$C_YELLOW" "$N_WARN" "$C_RESET" \
        "$C_RED" "$N_CRIT" "$C_RESET"
    echo
    if [ "$N_CRIT" -gt 0 ]; then
        printf '  %sЕсть критичные пробелы. Запусти:%s jarvis setup\n' "$C_RED" "$C_RESET"
        return 1
    elif [ "$N_WARN" -gt 0 ]; then
        printf '  %sГотов к запуску. Часть навыков деградирует — см. ⚠ выше.%s\n' "$C_YELLOW" "$C_RESET"
        return 0
    else
        printf '  %sВсё на месте. jarvis run.%s\n' "$C_GREEN" "$C_RESET"
        return 0
    fi
}

# ════════════════════════════════════════════════════════════════════════
#  jarvis setup — поставить всё, чего нет
# ════════════════════════════════════════════════════════════════════════
apt_install_missing() {
    step "Системные пакеты"
    if ! have apt-get; then
        note "apt-get не найден — пропускаю авто-установку пакетов (не Debian/Kali?)"
        return
    fi
    local need=() b pkg cls seen=" "
    for entry in "${TOOLS[@]}"; do
        IFS=':' read -r b pkg cls <<<"$entry"
        if ! have "$b"; then
            case "$seen" in *" $pkg "*) ;; *) need+=("$pkg"); seen="$seen$pkg ";; esac
        fi
    done
    # venv/pip всегда полезны.
    have python3 && ! python3 -c 'import venv' >/dev/null 2>&1 && need+=("python3-venv")
    if [ "${#need[@]}" -eq 0 ]; then
        ok "все системные пакеты уже стоят"
        return
    fi
    printf '  ставлю: %s\n' "${need[*]}"
    if sudo -n true 2>/dev/null || [ -t 0 ]; then
        sudo apt-get update -qq && sudo apt-get install -y "${need[@]}" \
            && ok "пакеты установлены" \
            || warn "apt не справился со всем — поставь вручную: sudo apt-get install ${need[*]}"
    else
        warn "нет прав sudo в неинтерактивном режиме. Выполни вручную:"
        note "sudo apt-get install -y ${need[*]}"
    fi
}

ensure_venv() {
    step "Python venv и зависимости"
    local py; py="$(venv_python)"
    if [ -z "$py" ]; then
        note "создаю .venv ..."
        python3 -m venv "$REPO_ROOT/.venv" || { crit "не создать venv"; return 1; }
        py="$REPO_ROOT/.venv/bin/python"
    fi
    # Ставим зависимости, только если чего-то не хватает (быстрый путь).
    local missing=0 mod
    for mod in "${PYDEPS[@]}"; do "$py" -c "import $mod" >/dev/null 2>&1 || missing=1; done
    if [ "$missing" -eq 1 ]; then
        note "pip install -r config/requirements.txt ..."
        "$py" -m pip install -q -r "$REPO_ROOT/config/requirements.txt" \
            && ok "зависимости установлены" || warn "часть зависимостей не встала — см. вывод pip"
    else
        ok "зависимости уже на месте"
    fi
}

# Выбор источника моделей до запуска тяжёлых скриптов: HF → зеркало → офлайн.
# Экспортирует MODEL_URL / EMBED_MODEL_URL (их читают setup-скрипты) и OFFLINE.
ensure_models_reachability() {
    step "Сеть и источник моделей"
    local need_chat=0 need_embed=0 embed_gguf
    [ -f "$CHAT_MODEL" ] || need_chat=1
    embed_gguf="$(ls "$EMBED_DIR"/*.gguf 2>/dev/null | head -1)"
    [ -n "$embed_gguf" ] || need_embed=1
    if [ "$need_chat" -eq 0 ] && [ "$need_embed" -eq 0 ]; then
        ok "обе модели уже на диске — сеть не нужна"
        return
    fi

    if net_dns_ok huggingface.co && reachable https://huggingface.co; then
        ok "huggingface.co доступен — качаю с него"
        return
    fi
    warn "huggingface.co недоступен"

    if net_dns_ok hf-mirror.com && reachable https://hf-mirror.com; then
        export MODEL_URL="${CHAT_MODEL_URL_HF/huggingface.co/hf-mirror.com}"
        export EMBED_MODEL_URL="${EMBED_MODEL_URL_HF/huggingface.co/hf-mirror.com}"
        ok "переключаюсь на зеркало hf-mirror.com"
        return
    fi

    OFFLINE=1
    if net_ip_ok; then
        crit "сеть есть, но DNS не резолвит имена (битый /etc/resolv.conf?)"
        note "быстрый фикс DNS:"
        note "  printf 'nameserver 1.1.1.1\\nnameserver 8.8.8.8\\n' | sudo tee /etc/resolv.conf"
    else
        crit "нет ни интернета, ни DNS — проверь подключение бокса"
    fi
    printf '\n  %sПодложи модели вручную (любая машина с интернетом) ровно сюда:%s\n' "$C_YELLOW" "$C_RESET"
    [ "$need_chat" -eq 1 ]  && { note "→ $CHAT_MODEL"; note "  из: $CHAT_MODEL_URL_HF"; }
    [ "$need_embed" -eq 1 ] && { note "→ $EMBED_DIR/multilingual-e5-small-F16.gguf"; note "  из: $EMBED_MODEL_URL_HF"; }
    note "затем повтори: jarvis setup  (готовые файлы скрипты не перекачивают)"
}

ensure_servers_built() {
    step "Сервер-мозг и модель (setup_server.sh)"
    if [ -x "$SERVER_BIN" ] && [ -f "$CHAT_MODEL" ] && [ -f "$UNIT_DIR/jarvis-llm.service" ]; then
        ok "бинарь, модель и юнит уже готовы — пропускаю сборку"
    elif [ "$OFFLINE" -eq 1 ] && [ ! -f "$CHAT_MODEL" ]; then
        warn "пропускаю setup_server.sh: нет модели и нет сети (см. подкладку выше)"
    else
        note "запускаю ./setup_server.sh (сборка Vulkan + модель + юнит) ..."
        "$REPO_ROOT/setup_server.sh" || warn "setup_server.sh завершился с ошибкой — см. вывод выше"
    fi

    step "Сервер-память (setup_embed_server.sh)"
    local embed_gguf; embed_gguf="$(ls "$EMBED_DIR"/*.gguf 2>/dev/null | head -1)"
    if [ -n "$embed_gguf" ] && [ -f "$UNIT_DIR/jarvis-embed.service" ]; then
        ok "embedding-модель и юнит уже готовы — пропускаю"
    elif [ "$OFFLINE" -eq 1 ] && [ -z "$embed_gguf" ]; then
        warn "пропускаю setup_embed_server.sh: нет модели и нет сети (см. подкладку выше)"
    else
        note "запускаю ./setup_embed_server.sh ..."
        "$REPO_ROOT/setup_embed_server.sh" || warn "setup_embed_server.sh завершился с ошибкой"
    fi
}

ensure_main_service() {
    step "Основной сервис ассистента"
    if [ -f "$UNIT_DIR/jarvis.service" ]; then
        ok "jarvis.service уже установлен"
    else
        note "ставлю через ./scripts/install_service.sh ..."
        "$REPO_ROOT/scripts/install_service.sh" 2>/dev/null \
            || "$REPO_ROOT/start_jarvis.sh" install \
            || warn "не удалось установить jarvis.service"
    fi
}

install_global_symlink() {
    step "Глобальная команда \`jarvis\`"
    local target="$HOME/.local/bin/jarvis"
    mkdir -p "$HOME/.local/bin"
    ln -sf "$REPO_ROOT/jarvis" "$target"
    ok "симлинк: $target → $REPO_ROOT/jarvis"
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ok "~/.local/bin уже в PATH";;
        *)
            # Дописываем PATH в rc-файл шелла (идемпотентно: только если строки нет).
            local line='export PATH="$HOME/.local/bin:$PATH"'
            local rc; local added=0
            for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
                [ -f "$rc" ] || continue
                if ! grep -qF "$line" "$rc" 2>/dev/null; then
                    printf '\n# jarvis CLI\n%s\n' "$line" >> "$rc"
                    ok "PATH дописан в $(basename "$rc")"
                    added=1
                fi
            done
            [ "$added" -eq 0 ] && note "добавь вручную в rc:  $line"
            note "примени сейчас:  export PATH=\"\$HOME/.local/bin:\$PATH\""
            ;;
    esac
}

cmd_setup() {
    printf '%s%s═══ JARVIS · установка ═══%s\n' "$C_CYAN" "$C_BOLD" "$C_RESET"
    apt_install_missing
    ensure_venv
    ensure_models_reachability
    ensure_servers_built
    ensure_main_service
    install_global_symlink
    printf '\n%s✓ Установка завершена.%s Проверь: %sjarvis test%s, запусти: %sjarvis run%s\n' \
        "$C_GREEN" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_BOLD" "$C_RESET"
}

# ════════════════════════════════════════════════════════════════════════
#  jarvis run — авто-починка + запуск
# ════════════════════════════════════════════════════════════════════════
wait_health() {
    local url="$1" label="$2" tries="${3:-90}" i
    printf '  ожидаю %s' "$label"
    for ((i=0; i<tries; i++)); do
        if http_get "$url" 2 | grep -q '"ok"'; then echo "  ✓"; return 0; fi
        printf '.'; sleep 1
    done
    echo "  ✗"; return 1
}

cmd_run() {
    printf '%s%s═══ JARVIS · запуск ═══%s\n' "$C_CYAN" "$C_BOLD" "$C_RESET"

    # 1. Лёгкая авто-починка отсутствующего (без принудительной пересборки).
    local py; py="$(venv_python)"
    [ -z "$py" ] && { ensure_venv; py="$(venv_python)"; }
    if [ -z "$py" ]; then crit "нет venv и не удалось создать — запусти jarvis setup"; exit 1; fi

    local embed_gguf; embed_gguf="$(ls "$EMBED_DIR"/*.gguf 2>/dev/null | head -1)"
    if [ ! -x "$SERVER_BIN" ] || [ ! -f "$CHAT_MODEL" ] || [ -z "$embed_gguf" ]; then
        warn "сервер/модели отсутствуют — добираю (с выбором источника)"
        ensure_models_reachability
        ensure_servers_built
    fi

    # 2. Поднять оба сервера.
    if have_systemd; then
        step "Поднимаю серверы (systemd --user)"
        [ -f "$UNIT_DIR/jarvis-llm.service" ] && systemctl --user start jarvis-llm.service 2>/dev/null
        [ -f "$UNIT_DIR/jarvis-embed.service" ] && systemctl --user start jarvis-embed.service 2>/dev/null
    else
        note "systemd --user недоступен — серверы должны быть запущены отдельно"
    fi
    wait_health "$CHAT_ENDPOINT/health"  "мозг (:8080)"   120 || warn "мозг не ответил — логи: jarvis logs llm"
    wait_health "$EMBED_ENDPOINT/health" "память (:8090)" 60  || warn "память не ответила — логи: jarvis logs embed"

    # 3. Запустить ассистента в foreground (Ctrl+C — стоп).
    step "Запускаю ассистента (Ctrl+C — остановить)"
    exec "$py" -m src.core.supervisor foreground
}

# ════════════════════════════════════════════════════════════════════════
#  управление
# ════════════════════════════════════════════════════════════════════════
cmd_status() {
    hdr "Состояние"
    local map=( "jarvis-llm:мозг (:8080)" "jarvis-embed:память (:8090)" "jarvis:ассистент" )
    for pair in "${map[@]}"; do
        IFS=':' read -r unit label <<<"$pair"
        if have_systemd && [ -f "$UNIT_DIR/$unit.service" ]; then
            local st; st="$(systemctl --user is-active "$unit" 2>/dev/null)"
            [ "$st" = "active" ] && ok "$label — active" || warn "$label — $st"
        else
            note "$label — юнит не установлен / нет systemd"
        fi
    done
    http_get "$CHAT_ENDPOINT/health" 3  | grep -q '"ok"' && ok "мозг отвечает на $CHAT_ENDPOINT"  || warn "мозг молчит"
    http_get "$EMBED_ENDPOINT/health" 3 | grep -q '"ok"' && ok "память отвечает на $EMBED_ENDPOINT" || warn "память молчит"
}

cmd_stop() {
    step "Остановка"
    if have_systemd; then
        systemctl --user stop jarvis 2>/dev/null && ok "ассистент остановлен" || true
        systemctl --user stop jarvis-embed 2>/dev/null && ok "память остановлена" || true
        systemctl --user stop jarvis-llm 2>/dev/null && ok "мозг остановлен" || true
    fi
    local py; py="$(venv_python)"
    [ -n "$py" ] && "$py" -m src.core.supervisor stop 2>/dev/null || true
}

cmd_restart() {
    if have_systemd && systemctl --user is-active --quiet jarvis 2>/dev/null; then
        systemctl --user restart jarvis && ok "ассистент перезапущен"
    else
        local py; py="$(venv_python)"
        [ -n "$py" ] && exec "$py" -m src.core.supervisor restart
    fi
}

cmd_logs() {
    local which="${1:-jarvis}" unit
    case "$which" in
        llm|brain|мозг)    unit="jarvis-llm";;
        embed|mem|память)  unit="jarvis-embed";;
        *)                 unit="jarvis";;
    esac
    if have_systemd; then
        printf '%s📋 Логи %s (Ctrl+C — выход)%s\n' "$C_YELLOW" "$unit" "$C_RESET"
        journalctl --user -u "$unit" -f
    else
        warn "systemd --user недоступен; в foreground-режиме логи идут прямо в консоль"
    fi
}

cmd_wipe_memory() {
    printf '%s⚠ Стираю базу памяти %s%s\n' "$C_YELLOW" "$MEMORY_DIR" "$C_RESET"
    note "нужно при смене embedding-модели (изменилась размерность вектора)."
    if [ ! -d "$MEMORY_DIR" ]; then ok "база и так пуста — нечего стирать"; return; fi
    printf 'Подтверди удаление (введи %syes%s): ' "$C_BOLD" "$C_RESET"
    read -r ans
    if [ "$ans" = "yes" ]; then
        rm -rf "$MEMORY_DIR" && ok "память стёрта — пересоздастся при следующем запуске"
    else
        note "отменено"
    fi
}

# ════════════════════════════════════════════════════════════════════════
#  диспетчер
# ════════════════════════════════════════════════════════════════════════
main() {
    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        run|up|start)          cmd_run "$@";;
        test|doctor|check|диагностика) cmd_test "$@";;
        setup|install|heal|fix) cmd_setup "$@";;
        status|стат)           cmd_status "$@";;
        stop|стоп)             cmd_stop "$@";;
        restart|рестарт)       cmd_restart "$@";;
        logs|логи)             cmd_logs "$@";;
        wipe-memory|wipe|clean-memory) cmd_wipe_memory "$@";;
        help|--help|-h|"")     cmd_help;;
        *)
            printf '%s✗ неизвестная команда: %s%s\n\n' "$C_RED" "$cmd" "$C_RESET"
            cmd_help
            exit 1;;
    esac
}

main "$@"
