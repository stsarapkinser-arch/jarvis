install_global_symlink() {
    step "Глобальная команда \`jarvis\`"
    local target="$HOME/.local/bin/jarvis"
    mkdir -p "$HOME/.local/bin"
    ln -sf "$REPO_ROOT/jarvis" "$target"
    ok "симлинк: $target → $REPO_ROOT/jarvis"
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ok "~/.local/bin уже в PATH";;
        *)
            # Дописываем PATH в rc-файл шелла (идемпотентно: только если строки нет).
            local line='export PATH="$HOME/.local/bin:$PATH"'
            local rc; local added=0
            for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
                [ -f "$rc" ] || continue
                if ! grep -qF "$line" "$rc" 2>/dev/null; then
                    printf '\n# jarvis CLI\n%s\n' "$line" >> "$rc"
                    ok "PATH дописан в $(basename "$rc")"
                    added=1
                fi
            done
            [ "$added" -eq 0 ] && note "добавь вручную в rc:  $line"
            note "примени сейчас:  export PATH=\"\$HOME/.local/bin:\$PATH\""
            ;;
    esac
}

