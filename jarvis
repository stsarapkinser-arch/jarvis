#  jarvis setup — поставить всё, чего нет
# ════════════════════════════════════════════════════════════════════════
apt_install_missing() {
    step "Системные пакеты"
    if ! have apt-get; then
        note "apt-get не найден — пропускаю авто-установку пакетов (не Debian/Kali?)"
        return
    fi
    local need=() b pkg cls seen=" "
    for entry in "${TOOLS[@]}"; do
        IFS=':' read -r b pkg cls <<<"$entry"
        if ! have "$b"; then
            case "$seen" in *" $pkg "*) ;; *) need+=("$pkg"); seen="$seen$pkg ";; esac
        fi
    done
    # venv/pip всегда полезны.
    have python3 && ! python3 -c 'import venv' >/dev/null 2>&1 && need+=("python3-venv")
    if [ "${#need[@]}" -eq 0 ]; then
        ok "все системные пакеты уже стоят"
        return
    fi
    printf '  ставлю: %s\n' "${need[*]}"
    if sudo -n true 2>/dev/null || [ -t 0 ]; then
        sudo apt-get update -qq && sudo apt-get install -y "${need[@]}" \
            && ok "пакеты установлены" \
            || warn "apt не справился со всем — поставь вручную: sudo apt-get install ${need[*]}"
    else
        warn "нет прав sudo в неинтерактивном режиме. Выполни вручную:"
        note "sudo apt-get install -y ${need[*]}"
    fi
}

ensure_venv() {
    step "Python venv и зависимости"
    local py; py="$(venv_python)"
    if [ -z "$py" ]; then
        note "создаю .venv ..."
        python3 -m venv "$REPO_ROOT/.venv" || { crit "не создать venv"; return 1; }
        py="$REPO_ROOT/.venv/bin/python"
    fi
    # Ставим зависимости, только если чего-то не хватает (быстрый путь).
    local missing=0 mod
    for mod in "${PYDEPS[@]}"; do "$py" -c "import $mod" >/dev/null 2>&1 || missing=1; done
    if [ "$missing" -eq 1 ]; then
        note "pip install -r config/requirements.txt ..."
        "$py" -m pip install -q -r "$REPO_ROOT/config/requirements.txt" \
            && ok "зависимости установлены" || warn "часть зависимостей не встала — см. вывод pip"
    else
        ok "зависимости уже на месте"
    fi
}

# Выбор источника моделей до запуска тяжёлых скриптов: HF → зеркало → офлайн.
# Экспортирует MODEL_URL / EMBED_MODEL_URL (их читают setup-скрипты) и OFFLINE.
ensure_models_reachability() {
    step "Сеть и источник моделей"
    local need_chat=0 need_embed=0 embed_gguf
    [ -f "$CHAT_MODEL" ] || need_chat=1
    embed_gguf="$(ls "$EMBED_DIR"/*.gguf 2>/dev/null | head -1)"
    [ -n "$embed_gguf" ] || need_embed=1
    if [ "$need_chat" -eq 0 ] && [ "$need_embed" -eq 0 ]; then
        ok "обе модели уже на диске — сеть не нужна"
        return
    fi

    if net_dns_ok huggingface.co && reachable https://huggingface.co; then
        ok "huggingface.co доступен — качаю с него"
        return
    fi
    warn "huggingface.co недоступен"

    if net_dns_ok hf-mirror.com && reachable https://hf-mirror.com; then
        export MODEL_URL="${CHAT_MODEL_URL_HF/huggingface.co/hf-mirror.com}"
        export EMBED_MODEL_URL="${EMBED_MODEL_URL_HF/huggingface.co/hf-mirror.com}"
        ok "переключаюсь на зеркало hf-mirror.com"
        return
    fi

    OFFLINE=1
    if net_ip_ok; then
        crit "сеть есть, но DNS не резолвит имена (битый /etc/resolv.conf?)"
        note "быстрый фикс DNS:"
        note "  printf 'nameserver 1.1.1.1\\nnameserver 8.8.8.8\\n' | sudo tee /etc/resolv.conf"
    else
        crit "нет ни интернета, ни DNS — проверь подключение бокса"
    fi
    printf '\n  %sПодложи модели вручную (любая машина с интернетом) ровно сюда:%s\n' "$C_YELLOW" "$C_RESET"
    [ "$need_chat" -eq 1 ]  && { note "→ $CHAT_MODEL"; note "  из: $CHAT_MODEL_URL_HF"; }
    [ "$need_embed" -eq 1 ] && { note "→ $EMBED_DIR/multilingual-e5-small-F16.gguf"; note "  из: $EMBED_MODEL_URL_HF"; }
    note "затем повтори: jarvis setup  (готовые файлы скрипты не перекачивают)"
}

