#!/usr/bin/env bash
# jarvis — единая точка входа. Одной командой проверить, починить и запустить.
#
#   jarvis run        поднять серверы и запустить ассистента (с авто-починкой)
#   jarvis test       полная диагностика: компоненты, серверы, память (read-only)
#   jarvis setup      установить/докачать всё, чего не хватает
#   jarvis help       список всех команд (на русском)
#
# Скрипт — диспетчер: тяжёлую работу делегирует идемпотентным
# setup_server.sh / setup_embed_server.sh / scripts/install_service.sh,
# а сам отвечает за единый UX, локализацию и сквозную проверку.
#
# Намеренно НЕ используем `set -e`: диагностика должна пройти до конца и
# собрать все проблемы, а не падать на первой. Критичные сбои в run/setup
# обрабатываются явными проверками и кодами возврата.
set -uo pipefail

# REPO_ROOT должен указывать на КОРЕНЬ РЕПО, даже когда скрипт вызван через
# PATH-симлинк (~/.local/bin/jarvis → …/projects/jarvis/jarvis). Без резолва
# симлинка ${BASH_SOURCE[0]} = сам симлинк, и REPO_ROOT уезжал в ~/.local/bin —
# отсюда ложные «нет GGUF/venv/piper» в `jarvis test`, хотя всё на месте.
_SELF="${BASH_SOURCE[0]}"
# Идём по цепочке симлинков до реального файла (readlink -f есть не везде —
# делаем переносимо вручную).
while [ -h "$_SELF" ]; do
    _link="$(readlink "$_SELF")"
    case "$_link" in
        /*) _SELF="$_link" ;;                                  # абсолютный
        *)  _SELF="$(dirname "$_SELF")/$_link" ;;              # относительный
    esac
done
REPO_ROOT="$(cd "$(dirname "$_SELF")" && pwd)"
cd "$REPO_ROOT"

# ───────────────────────── .env проекта ─────────────────────────
# Тумблеры (Tier 0 и прочее) живут в $REPO_ROOT/.env как KEY=VALUE и
# редактируются командой `jarvis toggle`. Грузим их в окружение ДО вычисления
# констант ниже — чтобы и сервер (setup), и рантайм (run) видели одно и то же.
# Парсим построчно, а НЕ `source`: файл не должен исполнять произвольный код.
# Уже заданное в шелле НЕ перетираем — `JARVIS_X=1 jarvis run` побеждает .env.
ENV_FILE="$REPO_ROOT/.env"
load_dotenv() {
    [ -f "$ENV_FILE" ] || return 0
    local line key val
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|'#'*) continue ;; esac      # пусто/комментарий
        case "$line" in *=*) ;; *) continue ;; esac    # не KEY=VALUE
        key="${line%%=*}"; key="${key// /}"
        [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        val="${line#*=}"
        val="${val%\"}"; val="${val#\"}"               # снять кавычки
        val="${val%\'}"; val="${val#\'}"
        [ -z "${!key+x}" ] && export "$key=$val"        # шелл > .env
    done < "$ENV_FILE"
}
load_dotenv

# ───────────────────────── палитра и примитивы ─────────────────────────
if [ -t 1 ]; then
    C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
    C_RED=$'\033[0;31m'; C_GREEN=$'\033[0;32m'; C_YELLOW=$'\033[1;33m'
    C_CYAN=$'\033[1;36m'; C_BLUE=$'\033[0;34m'
else
    C_RESET=''; C_DIM=''; C_BOLD=''; C_RED=''; C_GREEN=''; C_YELLOW=''; C_CYAN=''; C_BLUE=''
fi

# Счётчики для итогового вердикта диагностики.
N_OK=0; N_WARN=0; N_CRIT=0

hdr()  { printf '\n%s%s%s\n' "$C_CYAN$C_BOLD" "$*" "$C_RESET"; }
ok()   { N_OK=$((N_OK+1));   printf '  %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { N_WARN=$((N_WARN+1)); printf '  %s⚠%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
crit() { N_CRIT=$((N_CRIT+1)); printf '  %s✗%s %s\n' "$C_RED" "$C_RESET" "$*"; }
note() { printf '    %s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }
step() { printf '\n%s→ %s%s\n' "$C_BLUE$C_BOLD" "$*" "$C_RESET"; }

have() { command -v "$1" >/dev/null 2>&1; }

# ───────────────────────── константы окружения ─────────────────────────
SERVER_BIN="$REPO_ROOT/llama.cpp/build/bin/llama-server"
# Мозг по умолчанию — Qwen2.5-3B (см. setup_server.sh). Совпадает с MODEL_NAME
# там; при смене модели держите оба в синхроне (или переопределите CHAT_MODEL).
CHAT_MODEL="${CHAT_MODEL:-$REPO_ROOT/models/Qwen2.5-3B-Instruct-Q4_K_M.gguf}"
# Draft-модель для speculative decoding (тумблер draft). Имя — как DRAFT_NAME
# в setup_server.sh; переопределяемо для симметрии.
DRAFT_MODEL="${DRAFT_MODEL:-$REPO_ROOT/models/${DRAFT_NAME:-Qwen2.5-0.5B-Instruct-Q4_K_M.gguf}}"
EMBED_DIR="$REPO_ROOT/models/embed"
VOSK_MODEL="$REPO_ROOT/model"
PIPER_BIN="$REPO_ROOT/piper/piper"
PIPER_VOICE="$REPO_ROOT/piper/ru_RU-dmitri-medium.onnx"
PIPER_CFG="$REPO_ROOT/piper/ru_RU-dmitri-medium.json"
MEMORY_DIR="$REPO_ROOT/jarvis_memory"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

CHAT_ENDPOINT="${JARVIS_LLM_ENDPOINT:-http://127.0.0.1:8080}"
EMBED_ENDPOINT="${JARVIS_EMBED_ENDPOINT:-http://127.0.0.1:8090}"
EMBED_MODEL_ALIAS="${JARVIS_EMBED_MODEL:-multilingual-e5-small}"

# venv: тот же поиск, что в start_jarvis.sh (без realpath — иначе venv не активен).
venv_python() {
    if [ -f "$REPO_ROOT/.venv/bin/python" ]; then echo "$REPO_ROOT/.venv/bin/python"
    elif [ -f "$REPO_ROOT/venv/bin/python" ]; then echo "$REPO_ROOT/venv/bin/python"
    else echo ""; fi
}

# systemctl --user доступен? (на dev-машине/без user-сессии — нет; деградируем).
have_systemd() { have systemctl && systemctl --user show-environment >/dev/null 2>&1; }

# curl/wget с молчаливым GET.
http_get() {
    if have curl; then curl -fsS --max-time "${2:-4}" "$1" 2>/dev/null
    elif have wget; then wget -q -T "${2:-4}" -O - "$1" 2>/dev/null
    else return 2; fi
}

# Достижим ли URL (только заголовки, без тела) — для проверки источника моделей.
reachable() {
    if have curl; then curl -fsS --max-time "${2:-6}" -o /dev/null -I "$1" 2>/dev/null
    elif have wget; then wget -q -T "${2:-6}" --spider "$1" 2>/dev/null
    else return 2; fi
}
net_dns_ok() { getent hosts "$1" >/dev/null 2>&1; }
net_ip_ok()  { ping -c1 -W2 1.1.1.1 >/dev/null 2>&1; }

# Источники моделей: основной HF и зеркало (на случай блокировки/региона).
CHAT_MODEL_URL_HF="${CHAT_MODEL_URL_HF:-https://huggingface.co/bartowski/Qwen2.5-3B-Instruct-GGUF/resolve/main/Qwen2.5-3B-Instruct-Q4_K_M.gguf?download=true}"
# Публичное зеркало e5-small с корректной геометрией (ChristianAzinn ушёл в 401,
# tuskbot битый: context_length 511 vs тензор 512). keisuke-miyako грузится.
EMBED_MODEL_URL_HF="https://huggingface.co/keisuke-miyako/multilingual-e5-small-gguf-f16/resolve/main/multilingual-e5-small-F16.gguf?download=true"
OFFLINE=0  # выставляется ensure_models_reachability при отсутствии источника

# ───────────────── карта внешних инструментов → apt-пакет ─────────────────
# Формат: "бинарь:apt-пакет:класс". класс = build|core|opt.
#   build — нужно для сборки llama-server (только setup)
#   core  — без него заметно деградирует ядро
#   opt   — навык изящно отключается, не критично
TOOLS=(
    "git:git:build"
    "cmake:cmake:build"
    "cc:build-essential:build"
    "glslc:glslc:build"
    "vulkaninfo:vulkan-tools:build"
    "python3:python3:core"
    "sox:sox:core"
    "aplay:alsa-utils:core"
    "tesseract:tesseract-ocr:opt"
    "grim:grim:opt"
    "wmctrl:wmctrl:opt"
    "notify-send:libnotify-bin:opt"
    "playerctl:playerctl:opt"
    "wpctl:wireplumber:opt"
    "brightnessctl:brightnessctl:opt"
    "nmap:nmap:opt"
    "firejail:firejail:opt"
    "bwrap:bubblewrap:opt"
    "aria2c:aria2:opt"
    "curl:curl:core"
)

# Python-зависимости (импорт → пакет для сообщения).
PYDEPS=(
    "httpx" "chromadb" "vosk" "sounddevice" "PyQt6" "qasync"
    "psutil" "dbus_next" "numpy"
)

# ════════════════════════════════════════════════════════════════════════
#  jarvis help
# ════════════════════════════════════════════════════════════════════════
cmd_help() {
    banner
    printf '  %sИИ-оркестратор для Kali — проверить, починить и запустить одной командой%s\n' \
        "$C_DIM" "$C_RESET"
    cat <<EOF

${C_BOLD}ИСПОЛЬЗОВАНИЕ${C_RESET}  jarvis <команда> [аргументы]

${C_BOLD}ОСНОВНОЕ${C_RESET}
    ${C_GREEN}run${C_RESET}            поднять серверы и запустить ассистента (с авто-починкой)
    ${C_GREEN}setup${C_RESET}          установить/докачать всё, чего не хватает
    ${C_GREEN}test${C_RESET}           полная диагностика без изменений (read-only)
    ${C_GREEN}status${C_RESET}         состояние сервисов: мозг / память / ассистент

${C_BOLD}УПРАВЛЕНИЕ${C_RESET}
    restart        перезапустить ассистента
    stop           остановить ассистента и оба сервера
    logs [имя]     логи в реальном времени (jarvis | llm | embed)

${C_BOLD}НАСТРОЙКА${C_RESET}
    ${C_GREEN}toggle${C_RESET} [...]   тумблеры ускорений/функций (без аргументов — список)
    config         эффективная конфигурация: эндпоинты, модели, .env
    edit           открыть .env в \$EDITOR
    ${C_GREEN}commands${C_RESET}       добавить свои голосовые команды (config/commands.toml)
    calibrate      подобрать порог L2 (semantic) на живом эмбеддере

${C_BOLD}ИНСТРУМЕНТЫ${C_RESET}
    ${C_GREEN}ask${C_RESET} <текст>    разовый запрос к мозгу (без голоса)
    say <текст>    проверить голос (piper → колонки)
    bench [N]      замерить скорость мозга (tok/s)
    models         инвентарь моделей (размеры, наличие)

${C_BOLD}ОБСЛУЖИВАНИЕ${C_RESET}
    wipe-memory    стереть базу памяти (при смене embedding-модели)
    update         обновить репозиторий (git pull --ff-only)
    version        версия, ветка, окружение
    help           эта справка

${C_BOLD}ПРИМЕРЫ${C_RESET}
    jarvis setup
    jarvis toggle llm-stream on && jarvis restart   ${C_DIM}# рантайм${C_RESET}
    jarvis toggle kv-quant q8_0 && jarvis setup     ${C_DIM}# сборка${C_RESET}
    jarvis toggle semantic-threshold 0.68           ${C_DIM}# крутилка${C_RESET}
    jarvis ask "сколько свободно памяти"
    jarvis logs llm

${C_DIM}Все тумблеры и значения: jarvis toggle · обзор: jarvis config${C_RESET}
EOF
}

# ════════════════════════════════════════════════════════════════════════
#  jarvis test — read-only диагностика
# ════════════════════════════════════════════════════════════════════════
check_python() {
    hdr "[1] Python-окружение"
    local py; py="$(venv_python)"
    if [ -z "$py" ]; then
        crit "venv не найден (.venv/ или venv/) — \`jarvis setup\` создаст"
        return
    fi
    ok "venv: $py"
    local missing=()
    for mod in "${PYDEPS[@]}"; do
        "$py" -c "import $mod" >/dev/null 2>&1 || missing+=("$mod")
    done
    if [ "${#missing[@]}" -eq 0 ]; then
        ok "зависимости установлены (${#PYDEPS[@]} модулей)"
    else
        crit "не импортируются: ${missing[*]}"
        note "почини: jarvis setup  (pip install -r config/requirements.txt)"
    fi
}

check_artifacts() {
    hdr "[2] Бинарь сервера и модели"
    if [ -x "$SERVER_BIN" ]; then ok "llama-server собран"
    else crit "llama-server не собран — \`jarvis setup\` (или ./setup_server.sh)"; fi

    if [ -f "$CHAT_MODEL" ]; then ok "модель мозга: $(du -h "$CHAT_MODEL" 2>/dev/null | cut -f1)  $(basename "$CHAT_MODEL" .gguf)"
    else crit "нет GGUF мозга: $CHAT_MODEL"; fi

    local embed_gguf; embed_gguf="$(ls "$EMBED_DIR"/*.gguf 2>/dev/null | head -1)"
    if [ -n "$embed_gguf" ]; then ok "embedding-модель: $(basename "$embed_gguf")"
    else crit "нет embedding-модели в $EMBED_DIR"; fi

    if [ -d "$VOSK_MODEL" ] && [ -n "$(ls -A "$VOSK_MODEL" 2>/dev/null)" ]; then ok "Vosk-модель (слух) на месте"
    else warn "Vosk-модель не найдена в $VOSK_MODEL — докачай: jarvis setup (или bash scripts/fetch_assets.sh)"; fi
}

check_network() {
    hdr "[*] Сеть и источник моделей"
    local embed_gguf; embed_gguf="$(ls "$EMBED_DIR"/*.gguf 2>/dev/null | head -1)"
    if [ -f "$CHAT_MODEL" ] && [ -n "$embed_gguf" ]; then
        ok "обе модели на диске — сеть для установки не нужна"
        return
    fi
    if net_dns_ok huggingface.co && reachable https://huggingface.co; then
        ok "huggingface.co доступен — setup скачает напрямую"
    elif net_dns_ok hf-mirror.com && reachable https://hf-mirror.com; then
        warn "HF недоступен, но зеркало hf-mirror.com — да (setup переключится сам)"
    elif net_ip_ok; then
        crit "сеть есть, DNS не резолвит (битый /etc/resolv.conf) — модели не скачать"
        note "фикс: printf 'nameserver 1.1.1.1\\n' | sudo tee /etc/resolv.conf"
    else
        crit "нет сети/DNS — подложи модели вручную (jarvis setup подскажет пути)"
    fi
}

check_proactive() {
    hdr "[*] Проактивность и взгляд на экран"
    local iv; iv="${JARVIS_PROACTIVE_INTERVAL:-1200}"
    if [ "$iv" = "1200" ] || [ -z "${JARVIS_PROACTIVE_INTERVAL:-}" ]; then
        ok "порог тишины: 1200с (20 мин) — штатный режим"
        note "для быстрой проверки взгляда: JARVIS_PROACTIVE_INTERVAL=60 jarvis run"
    else
        warn "порог тишины снижен до ${iv}с (JARVIS_PROACTIVE_INTERVAL) — тестовый режим"
        note "этот же порог гейтит и «взгляд на экран» — удобно для проверки"
    fi
    local sw; sw="${JARVIS_SCREEN_WATCH:-1}"
    case "$sw" in
        0|false|no|off) note "взгляд на экран ВЫКЛЮЧЕН (JARVIS_SCREEN_WATCH=$sw)";;
        *) ok "взгляд на экран включён (JARVIS_SCREEN_WATCH=$sw)";;
    esac
}

check_voice() {
    hdr "[3] Голос (Piper TTS)"
    [ -x "$PIPER_BIN" ] && ok "piper-бинарь" || warn "нет piper-бинаря ($PIPER_BIN) — докачай: jarvis setup (или bash scripts/fetch_assets.sh)"
    [ -f "$PIPER_VOICE" ] && ok "русский голос ru_RU-dmitri" || warn "нет голоса ($PIPER_VOICE) — докачай: jarvis setup"
    [ -f "$PIPER_CFG" ] && ok "конфиг голоса" || warn "нет конфига голоса: $PIPER_CFG"
}

check_kwin_scripts() {
    hdr "[*] KWin-скрипты (управление окнами HUD)"
    local sd="$REPO_ROOT/scripts" missing=0 js
    for js in highlight_window.js prepare_workspace.js enumerate_windows.js; do
        [ -f "$sd/$js" ] || { warn "нет $js"; missing=1; }
    done
    [ "$missing" -eq 0 ] && ok "named-скрипты на месте (scripts/)"
    if mkdir -p "$sd/_inline" 2>/dev/null && [ -w "$sd/_inline" ]; then
        ok "scripts/_inline/ доступен для записи (inline KWin)"
    else
        warn "scripts/_inline/ не создать/не записать — пин HUD будет спамить ошибками"
    fi
}

check_chat_server() {
    hdr "[4] Сервер-мозг (:8080)"
    local h; h="$(http_get "$CHAT_ENDPOINT/health" 4)"
    if [ -z "$h" ]; then
        crit "недоступен на $CHAT_ENDPOINT — \`jarvis run\` поднимет"
        return
    fi
    if grep -q '"ok"' <<<"$h"; then ok "/health отвечает"
    else warn "ответил, но не 'ok': $h"; fi
    # tool-calling доступен?
    local models; models="$(http_get "$CHAT_ENDPOINT/v1/models" 4)"
    grep -q '"id"' <<<"$models" && ok "модель отдаётся через /v1/models" \
        || warn "/v1/models не вернул модель"
    # GPU-оффлоад (по логам systemd, если доступны).
    if have_systemd; then
        local glog; glog="$(journalctl --user -u jarvis-llm --no-pager -n 400 2>/dev/null)"
        if grep -qiE "offloaded [0-9]+/[0-9]+ layers|Vulkan0|using Vulkan|ggml_vulkan" <<<"$glog"; then
            ok "iGPU-оффлоад активен (Vulkan)"
        else
            warn "не вижу следов Vulkan в логах — возможно инференс на CPU (медленно)"
        fi
    fi
}

check_embed_server() {
    hdr "[5] Сервер-память / эмбеддинги (:8090)"
    local h; h="$(http_get "$EMBED_ENDPOINT/health" 4)"
    if [ -z "$h" ]; then
        crit "недоступен на $EMBED_ENDPOINT — память не вспомнит; \`jarvis run\` поднимет"
        return
    fi
    ok "/health отвечает"
    # Реальная проба: непустой вектор на русскую фразу + размерность.
    local resp=""
    if have curl; then
        resp="$(curl -fsS --max-time 8 "$EMBED_ENDPOINT/v1/embeddings" \
            -H 'Content-Type: application/json' \
            -d "{\"model\":\"$EMBED_MODEL_ALIAS\",\"input\":\"проверка связи\"}" 2>/dev/null)"
    fi
    if grep -q '"embedding"' <<<"$resp"; then
        local dim; dim="$(grep -o '"embedding":\[[^]]*' <<<"$resp" | tr ',' '\n' | grep -c '.')"
        ok "эмбеддинг получен (размерность ~${dim})"
        echo "$dim" > /tmp/jarvis-live-embed-dim 2>/dev/null || true
    else
        warn "сервер жив, но /v1/embeddings не вернул вектор — проверь модель/флаг --embedding"
    fi
}

check_memory() {
    hdr "[6] Память (ChronoMemory / Chroma)"
    local db="$MEMORY_DIR/chroma.sqlite3"
    if [ ! -d "$MEMORY_DIR" ]; then
        warn "база ещё не создана — появится при первом запуске (это норма)"
        return
    fi
    if [ -f "$db" ]; then
        ok "база на месте: $db"
        if have sqlite3; then
            local rows; rows="$(sqlite3 "$db" "select count(*) from embeddings;" 2>/dev/null)"
            [ -n "$rows" ] && note "записей в памяти: $rows"
        fi
        note "ВАЖНО: при смене embedding-модели меняется размерность → база"
        note "становится несовместимой. Лечится: jarvis wipe-memory"
    else
        warn "каталог есть, но chroma.sqlite3 нет — будет создан при старте"
    fi
    [ -f "$MEMORY_DIR/skill_overrides.json" ] && ok "skill_overrides.json (самолечение навыков)" \
        || note "skill_overrides.json пока нет (появится после первой самопочинки навыка)"
}

check_tools() {
    hdr "[7] Внешние инструменты"
    # qdbus6/qdbus отдельно — ключ к самолечению навыков.
    if have qdbus6; then ok "qdbus6 (KDE/Plasma)"
    elif have qdbus; then warn "qdbus6 нет, есть qdbus — навыки самовылечатся на лету (ожидаемо)"
    else warn "ни qdbus6, ни qdbus — управление окнами/Plasma деградирует"; fi

    local b pkg cls
    for entry in "${TOOLS[@]}"; do
        IFS=':' read -r b pkg cls <<<"$entry"
        if have "$b"; then
            ok "$b"
        else
            case "$cls" in
                build) warn "$b — нужен для сборки сервера (пакет: $pkg)";;
                core)  warn "$b — ядро деградирует (пакет: $pkg)";;
                *)     note "нет $b — соответствующий навык отключится (пакет: $pkg)";;
            esac
        fi
    done
}

check_units() {
    hdr "[8] systemd --user юниты"
    if ! have_systemd; then
        note "systemd --user недоступен в этой сессии — пропускаю (норма для dev-машины)"
        return
    fi
    local u
    for u in jarvis-llm jarvis-embed jarvis; do
        if [ -f "$UNIT_DIR/$u.service" ]; then
            local st; st="$(systemctl --user is-active "$u" 2>/dev/null)"
            if [ "$st" = "active" ]; then ok "$u.service — активен"
            else warn "$u.service установлен, но $st"; fi
        else
            warn "$u.service не установлен — \`jarvis setup\` поставит"
        fi
    done
}

