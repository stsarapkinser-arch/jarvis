[Unit]
Description=JARVIS Protocol — AI Orchestrator for Kali Linux
After=graphical-session.target sound.target plasma-kwin_wayland.service jarvis-llm.service
PartOf=graphical-session.target
# jarvis-llm (нативный llama-server, главный мозг) и ollama (эмбеддинги памяти)
# — soft-dep: не падаем, если их нет (Jarvis скажет голосом и продолжит), но
# стараемся поднять мозг до оркестратора.
Wants=jarvis-llm.service
Wants=ollama.service

[Service]
# Бессмертие: ExecStart запускает внешний супервизор (слой 2), который
# стережёт python -m src.core.bootstrap и поднимает его при любом падении/
# убийстве. foreground — супервизор не демонизируется, его держит сам systemd.
Type=notify
# sd_notify (READY=1/WATCHDOG=1) шлёт дочерний bootstrap, не супервизор,
# поэтому нужен all, а не main.
NotifyAccess=all
WorkingDirectory=__JARVIS_HOME__
ExecStart=__JARVIS_PYTHON__ -m src.core.supervisor foreground
ExecStop=__JARVIS_PYTHON__ -m src.core.supervisor stop
Restart=always
RestartSec=2
# Системд watchdog: если event-loop bootstrap завис (дедлок, OOM) и перестал
# слать WATCHDOG=1 — systemd убивает cgroup юнита и перезапускает через 2с.
WatchdogSec=30
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=__JARVIS_HOME__
# Инференс вынесен в отдельный демон (jarvis-llm.service). Python только
# ходит к нему по HTTP (OpenAI REST). Все llama-cpp env (GPU layers, ctx,
# batch) теперь живут в config/jarvis-llm.service, а не здесь.
Environment=JARVIS_LLM_ENDPOINT=http://127.0.0.1:8080
Environment=JARVIS_LLM_MODEL=llama-3.2-3b-instruct
Environment=QT_QPA_PLATFORM=wayland
# OpenGL на Intel N100: дать Mesa выбрать iris (Gen12) — без override
# падал на llvmpipe. Если у пользователя другой драйвер — пусть
# переопределит в drop-in.
Environment=MESA_LOADER_DRIVER_OVERRIDE=iris

[Install]
WantedBy=graphical-session.target
